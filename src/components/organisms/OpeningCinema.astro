---
/**
 * 开场动画（Opening Cinema）——首页首次进入时的全屏开场。
 *
 * 时序：灰度底图 → 自左上角径向扩散出彩色 → 站点名逐字落下 → 按时段问候语打字机 → 整层上移收场。
 *
 * 契约：
 * - 仅当 `openingAnimationConfig.enable` 为真且当前页是首页时渲染；关闭时零 DOM、零图片请求、零脚本。
 * - 全程离线，不发起任何外部网络请求（问候语按访客本地时间分档，纯本地计算）。
 * - 位于 `#swup-container` 之外，Swup 换页不会重放；同一会话只播一次（`sessionStorage`，标记在**播完之后**才写）。
 * - 想再看一次：显示设置面板里的「重播开场动画」，它清掉标记后整页回首页重放。
 * - 站点「减少动态效果」打开时直接跳过（唯一降级入口，见改造计划 §6.8）；访客显式重播那一轮除外。
 * - 无 JavaScript 时由 `<noscript>` 隐藏，页面照常可用。
 */
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { resolveImageAsset } from "@utils/asset-utils";
import { openingAnimationConfig, siteConfig } from "@/config";

interface Props {
	/** 当前页标识；只有 `home` 播放。 */
	page?: string;
}

const { page } = Astro.props;
const { enable, desktopImage, mobileImage, duration } = openingAnimationConfig;

/** 仅首页启用时才解析图片，关闭时完全不触碰资源管线。 */
const active = enable && page === "home";

const resolveSrc = async (src: string): Promise<string> => {
	if (!active) return "";
	const resolved = await resolveImageAsset(src);
	return typeof resolved === "string" ? resolved : resolved.src;
};

const [desktopSrc, mobileSrc] = active
	? await Promise.all([resolveSrc(desktopImage), resolveSrc(mobileImage)])
	: ["", ""];

/**
 * 时段问候语分档：访客本地小时数（不含上界）→ 文案。
 * 语言在构建期由 `siteConfig.lang` 决定，时段在运行期由访客时钟决定（零网络请求）。
 * 首尾两档同为「夜深了」，`find` 因此必然命中，无需兜底分支。
 */
const greetingTable = [
	{ maxHour: 5, text: i18n(I18nKey.openingGreetingLateNight) },
	{ maxHour: 11, text: i18n(I18nKey.openingGreetingMorning) },
	{ maxHour: 13, text: i18n(I18nKey.openingGreetingNoon) },
	{ maxHour: 18, text: i18n(I18nKey.openingGreetingAfternoon) },
	{ maxHour: 23, text: i18n(I18nKey.openingGreetingEvening) },
	{ maxHour: 24, text: i18n(I18nKey.openingGreetingLateNight) },
];

/** 落下的标题取自首页 Banner 主标题，站点名不在两处重复配置。 */
const titleChars = [...siteConfig.banner.homeText.title].map((char) =>
	char === " " ? "\u00a0" : char,
);

/** 图片地址经 CSS 自定义属性下发，由媒体查询在桌面/移动之间切换。 */
const cinemaStyle = `--oc-desktop:url("${desktopSrc}");--oc-mobile:url("${mobileSrc}")`;
---

{
	active && (
		<>
			<div
				id="opening-cinema"
				class="opening-cinema"
				aria-hidden="true"
				data-duration={duration}
				style={cinemaStyle}
			>
				<div class="opening-cinema__frame">
					<div class="opening-cinema__blur"></div>
					<!-- 彩色模糊层：只给「留白条」上色（image 层是 contain，上下/左右会露出模糊底）。
					     它和灰模糊层同尺寸、滤镜静态，靠同一个圆被揭开 —— 逐帧只改 clip-path。 -->
					<div class="opening-cinema__blur opening-cinema__blur--color"></div>
					<div class="opening-cinema__image"></div>
					<div class="opening-cinema__image opening-cinema__image--reveal"></div>
					<div class="opening-cinema__title">
						{titleChars.map((char) => (
							<span class="opening-cinema__char">{char}</span>
						))}
					</div>
					<p class="opening-cinema__greeting">
						<span
							class="opening-cinema__type"
							data-greetings={JSON.stringify(greetingTable)}
						/>
					</p>
				</div>
			</div>
			<script is:inline>
				// 这段脚本在**首帧之前**执行（模块脚本晚于首帧），负责两件事：
				// 1. 重播入口留的一次性标记（键名同 src/utils/opening-animation.ts 的 OPENING_FORCE_KEY）
				//    → 加 .opening-cinema--forced，让降级规则（html.motion-reduced 下 display:none）不生效。
				// 2. 本会话已播过（OPENING_SEEN_KEY）→ 加 .opening-cinema--skip 直接隐藏。
				//    否则要等模块脚本跑起来才撤遮罩，刷新时访客会先看到一段灰糊图（2026-09-17 站主反馈）。
				try {
					const cinema = document.getElementById("opening-cinema");
					if (sessionStorage.getItem("shirone-opening-force.v1") === "1") {
						cinema?.classList.add("opening-cinema--forced");
					} else if (sessionStorage.getItem("shirone-opening-played.v1") === "1") {
						cinema?.classList.add("opening-cinema--skip");
					}
				} catch {}
			</script>
			<noscript>
				<style is:inline set:html={"#opening-cinema{display:none}"} />
			</noscript>
		</>
	)
}

<script>
	import { prefersReducedMotion } from "@utils/motion";
	import {
		consumeOpeningForcedPlay,
		hasSeenOpening,
		markOpeningSeen,
	} from "@utils/opening-animation";

	/** 设计基准时长；`duration` 配置项作为整体倍率，各阶段按比例缩放。 */
	const BASE_DURATION = 4120;

	/** 各阶段在设计基准时长下的毫秒位置。 */
	const PHASE = {
		reveal: 1050,
		charStart: 1050,
		charStep: 60,
		charDur: 550,
		typeStart: 2000,
		typeDur: 950,
		liftStart: 3220,
		liftDur: 900,
	};

	/** 径向扩散圆心（左上，与图面高光同侧）与最大半径占比。 */
	const REVEAL_ORIGIN = "15% 17%";
	const REVEAL_MAX = 125;

	/**
	 * 彩色模糊层的圆心与半径系数。
	 * 它和灰模糊层一样是 `inset: -10%`（盒子放大 1.1 倍），而 `circle()` 的百分比半径是相对
	 * 自身参考框（sqrt(w²+h²)/√2）算的 —— 同一个百分比落到它身上会大 1.1 倍。
	 * 所以半径乘 1/1.1，圆心也按 1/1.1 折算（15/1.1 ≈ 13.64，17/1.1 ≈ 15.45）。
	 */
	const REVEAL_ORIGIN_BLUR = "13.64% 15.45%";
	const REVEAL_BLUR_RATIO = 1 / 1.1;

	/** 收场上移比例（%），略大于 100 以确保整层完全移出视口。 */
	const LIFT_DISTANCE = -103;

	/** 打字机光标闪烁周期（ms）。 */
	const CARET_BLINK = 700;

	interface Greeting {
		maxHour: number;
		text: string;
	}

	/** 取必需的子元素；结构缺失时抛错，由启动处的兜底逻辑撤下遮罩。 */
	function must<T extends Element>(scope: ParentNode, selector: string): T {
		const el = scope.querySelector<T>(selector);
		if (!el) throw new Error(`opening-cinema: 缺少 ${selector}`);
		return el;
	}

	const clamp01 = (value: number): number => (value < 0 ? 0 : value > 1 ? 1 : value);
	const easeInOutSine = (p: number): number => -(Math.cos(Math.PI * p) - 1) / 2;
	const easeInOutCubic = (p: number): number =>
		p < 0.5 ? 4 * p * p * p : 1 - (-2 * p + 2) ** 3 / 2;
	const easeOutBack = (p: number): number => {
		const c1 = 1.70158;
		return 1 + (c1 + 1) * (p - 1) ** 3 + c1 * (p - 1) ** 2;
	};
	const lerp = (from: number, to: number, t: number): number => from + (to - from) * t;

	/**
	 * 播放代次令牌。每次 `boot()` 自增，异步续作（rAF 步进、字体到位回调）都校验自己那一代，
	 * 于是重入时旧驱动会自行退出，不会和新播放抢同一份样式。
	 * 目前整页加载只会 `boot()` 一次，这道令牌是为将来的「站内重播」预留的。
	 */
	let playbackToken = 0;


	/**
	 * 起播门槛（ms）：不早于这个时刻起跑 —— 至少让首屏先拿到一次绘制。
	 * 实测（生产构建 + 静态服务器）本机首屏长任务集中在 192-498ms，而模块脚本 215-411ms
	 * 就已经起播，两者正面重叠，正是「扩散段」掉帧的成因。
	 */
	const START_FLOOR = 300;

	/** 起播前要求的「无长任务」静默窗口（ms）。 */
	const QUIET_GAP = 200;

	/** 兜底上限（ms）：等不到安静也必须起播 —— 宁可掉几帧，不能让灰遮罩一直挂着。 */
	const START_CAP = 1200;

	/**
	 * 等首屏安静再起播。
	 *
	 * 为什么需要：按**动画自身的时间轴**分阶段实测，扩散段（0-1050ms）是全片唯一掉帧的一段
	 * （p50 = 33ms、20+ 个 >32ms 的帧），而它恰好压在页面自己的长任务上；其后的打字机段、
	 * 收场上移段同样逐帧改样式却 **0 掉帧**。把起跑挪到长任务之后，扩散就落进满帧的那段时间。
	 *
	 * 判据用「最近 QUIET_GAP 毫秒内没有长任务」，而不是「rAF 间隔够小」：页面静止时浏览器会把
	 * rAF 降到 ~30fps（无头环境必现），拿帧间隔当判据会把「安静」误判成「还在卡」。
	 */
	function whenFirstScreenQuiet(begin: () => void): void {
		const from = performance.now();
		let lastLongTask = 0;
		let observer: PerformanceObserver | undefined;
		try {
			observer = new PerformanceObserver((list) => {
				for (const entry of list.getEntries()) {
					lastLongTask = Math.max(lastLongTask, entry.startTime + entry.duration);
				}
			});
			// buffered: 连观察器建立之前（也就是首屏加载阶段）的长任务一起收进来。
			observer.observe({ type: "longtask", buffered: true });
		} catch {
			// 不支持 longtask 观测（Safari 等）：退化成「只等 START_FLOOR」。
		}

		const check = (now: number): void => {
			const waited = now - from;
			if (waited >= START_CAP || (waited >= START_FLOOR && now - lastLongTask >= QUIET_GAP)) {
				observer?.disconnect();
				begin();
				return;
			}
			requestAnimationFrame(check);
		};
		requestAnimationFrame(check);
	}

	/** 动画期间锁住文档滚动，返回恢复函数。 */
	function lockScroll(): () => void {
		const previous = document.documentElement.style.overflow;
		document.documentElement.style.overflow = "hidden";
		return () => {
			document.documentElement.style.overflow = previous;
		};
	}

	function boot(root: HTMLElement): void {
		// 访客显式点过「重播」：这一轮越过降级开关。标记**先消费掉**再判断 ——
		// 它是一次性的，留在会话里会让此后每次加载都绕过降级。
		const forced = consumeOpeningForcedPlay();

		// 本会话已播过，或站点要求降级动效：直接撤下遮罩，不做任何动画。
		if (!forced && (hasSeenOpening() || prefersReducedMotion())) {
			root.remove();
			return;
		}

		const token = ++playbackToken;
		const frame = must<HTMLElement>(root, ".opening-cinema__frame");
		// 灰模糊层现在完全由 CSS 负责（滤镜静态），这里只做一次存在性校验。
		must<HTMLElement>(root, ".opening-cinema__blur");
		const blurColorLayer = must<HTMLElement>(root, ".opening-cinema__blur--color");
		const revealLayer = must<HTMLElement>(root, ".opening-cinema__image--reveal");
		const typeEl = must<HTMLElement>(root, ".opening-cinema__type");
		const chars = [...root.querySelectorAll<HTMLElement>(".opening-cinema__char")];

		// 动画期间锁滚动，避免遮罩下方的内容跟着滚轮/手指移动。
		const unlockScroll = lockScroll();

		const scale = (Number(root.dataset.duration) || BASE_DURATION) / BASE_DURATION;
		const duration = BASE_DURATION * scale;
		const at = (ms: number): number => ms * scale;

		// 时段问候语：构建期定语言，运行期按访客本地时钟选分档。
		let table: Greeting[] = [];
		try {
			table = JSON.parse(typeEl.dataset.greetings ?? "[]") as Greeting[];
		} catch {
			table = [];
		}
		const hour = new Date().getHours();
		const greeting = table.find((entry) => hour < entry.maxHour)?.text ?? "";

		let typeWidth = 0;
		/**
		 * 量出打字机需要的完整宽度。
		 * 中文不能用 `ch` 作宽度单位（`ch` 是 "0" 的字宽，只有汉字的一半），必须实测 `scrollWidth`。
		 */
		const measure = (): void => {
			if (!greeting) return;
			typeEl.textContent = greeting;
			typeEl.style.width = "auto";
			typeWidth = typeEl.scrollWidth;
			typeEl.style.width = "0px";
		};

		function render(ms: number): void {
			const reveal = easeInOutSine(clamp01(ms / at(PHASE.reveal)));
			const lift = easeInOutCubic(clamp01((ms - at(PHASE.liftStart)) / at(PHASE.liftDur)));
			const typed = clamp01((ms - at(PHASE.typeStart)) / at(PHASE.typeDur));

			frame.style.transform = `translateY(${lift * LIFT_DISTANCE}%)`;
			revealLayer.style.clipPath = `circle(${(reveal * REVEAL_MAX).toFixed(2)}% at ${REVEAL_ORIGIN})`;
			// 灰模糊层的滤镜保持静态：逐帧重写 filter 会让整条模糊管线每帧重算（实测最主要的掉帧源）。
			// 「去灰」改由上面那层静态彩色的模糊层按同一个圆揭开 —— 留白条照样跟着圆一起上色。
			blurColorLayer.style.clipPath = `circle(${(
				reveal * REVEAL_MAX * REVEAL_BLUR_RATIO
			).toFixed(2)}% at ${REVEAL_ORIGIN_BLUR})`;

			typeEl.style.width = `${typed * typeWidth}px`;
			typeEl.style.borderColor =
				ms > at(PHASE.typeStart) + at(PHASE.typeDur) && Math.floor(ms / CARET_BLINK) % 2
					? "transparent"
					: "";

			chars.forEach((char, index) => {
				const progress = clamp01(
					(ms - at(PHASE.charStart + index * PHASE.charStep)) / at(PHASE.charDur),
				);
				const eased = progress >= 1 ? 1 : easeOutBack(progress);
				char.style.opacity = String(clamp01(progress * 4));
				char.style.transform = `translateY(${lerp(-30, 0, eased)}px) rotate(${lerp(
					-9,
					0,
					eased,
				)}deg) scale(${lerp(0.86, 1, eased)})`;
			});
		}

		let finished = false;
		let raf = 0;
		/** 已渲染到的时间点：rAF 时间戳在个别帧会抖动，用它钳住单调递增，避免画面回退。 */
		let rendered = 0;
		let startedAt = performance.now();

		const finish = (): void => {
			if (token !== playbackToken) return;
			finished = true;
			cancelAnimationFrame(raf);
			unlockScroll();
			root.remove();
		};

		const step = (now: number): void => {
			if (token !== playbackToken) return;
			rendered = Math.max(rendered, Math.min(now - startedAt, duration));
			try {
				render(rendered);
			} catch {
				finish();
				return;
			}
			if (rendered < duration) {
				raf = requestAnimationFrame(step);
			} else {
				// 完整播完才记「已播过」。若在启动时（boot）就落标记，动画中途被整页重载打断时，
				// 标记已写入，该标签页整轮会话都会被判为「已播过」而再也不播——dev 冷启动时
				// Vite 重新预构建依赖会强制刷新 2~3 次，正好踩中这一点。
				markOpeningSeen();
				finish();
			}
		};

		measure();
		// Web 字体到位后重测宽度，避免打字机把中文截断。
		document.fonts?.ready
			.then(() => {
				if (finished || !root.isConnected || token !== playbackToken) return;
				// 只重测宽度；帧一律由 rAF 的单一时间源推进，不在这里重放。
				measure();
			})
			.catch(() => {
				// 字体探测失败不影响动画本身。
			});

		/** 真正起跑：定位时间基准、渲染首帧、启动 rAF。等首屏安静之后才被调用一次。 */
		const begin = (): void => {
			if (token !== playbackToken || finished) return;
			// 等待期屏幕上只有米白底 + 呼吸线（样式里 .opening-cinema__frame 是 opacity: 0）。
			// 这里把它 200ms 淡入成灰阶画面，随后第一段立刻起跑 —— 两者并行，总时长不变。
			root.classList.add("opening-cinema--ready");
			try {
				// 时间基准必须落在这里：等待期间没渲染，若沿用 boot 时刻，动画会一开始就跳过等待的那段。
				startedAt = performance.now();
				rendered = 0;
				render(rendered);
				raf = requestAnimationFrame(step);
			} catch {
				finish();
			}
		};

		try {
			whenFirstScreenQuiet(begin);
		} catch {
			finish();
		}
	}

	const cinema = document.getElementById("opening-cinema");
	if (cinema) {
		try {
			boot(cinema);
		} catch {
			// 结构异常或初始化失败：撤下遮罩并解锁滚动，页面照常可用。
			if (document.documentElement.style.overflow === "hidden") {
				document.documentElement.style.overflow = "";
			}
			cinema.remove();
		}
	}
</script>

<style lang="stylus">
	.opening-cinema
		position: fixed
		inset: 0
		z-index: 90
		overflow: hidden
		background-color: #efebe3
		--oc-img: var(--oc-desktop)
		/* 标题字号向首页横幅大字看齐（横幅 h1 是 80px）：开场收场时两处大小相近，视觉才接得上。
		   原先上限 40px 在 1440/1920 屏上明显偏小，站主要求放大、不怕压住图。 */
		--oc-title-size: clamp(40px, 6vw, 88px)
		--oc-greeting-size: clamp(15px, 1.35vw, 22px)

	/* 标题与问候语作为**一个整体**垂直居中。原来靠两个绝对定位 + 魔法偏移量
	   （top:50% 与 top:calc(50% + 46px)）—— 46px 是按 40px 标题手调的，字号一变就得同时改两处；
	   改用 flex 后它们自然排成一个居中块，移动端也才真正居中。
	   图片三层（blur / image / reveal）都是绝对定位，不受这个 flex 影响。 */
	.opening-cinema__frame
		position: absolute
		inset: 0
		display: flex
		flex-direction: column
		align-items: center
		justify-content: center
		padding: 0 var(--m3e-space-6)
		will-change: transform
		/* 等待期（起播前）整体不可见：屏幕上只留根元素的米白底 + 下面那条呼吸细线，
		   避免「一张静止的糊灰图」定在屏幕上。起播时由脚本加 .opening-cinema--ready 淡入。
		   默认态必须写在 CSS 而不是脚本里 —— 否则 SSR 首帧会先亮一下灰糊图。 */
		opacity: 0
		transition: opacity 200ms ease-out

	.opening-cinema__blur
		position: absolute
		inset: -10%
		background-image: var(--oc-img)
		background-position: center
		background-repeat: no-repeat
		background-size: cover
		filter: blur(28px) grayscale(1) brightness(0.82)

	/* 彩色模糊层：只负责给「留白条」上色 —— image 层是 contain，上下/左右会露出模糊底。
	   两层模糊的滤镜全程静态，逐帧只由 JS 改这一层的 clip-path，
	   避免每帧重算 blur 管线（实测那是最主要的掉帧源）。 */
	.opening-cinema__blur--color
		filter: blur(28px) brightness(0.88)
		clip-path: circle(0% at 13.64% 15.45%)

	.opening-cinema__image
		position: absolute
		inset: 0
		background-image: var(--oc-img)
		background-position: center
		background-repeat: no-repeat
		background-size: contain
		filter: grayscale(1) brightness(0.92)

	.opening-cinema__image--reveal
		filter: none
